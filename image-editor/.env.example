# Copy this file to .env in this same folder.
# .env stays on your computer. Do not commit it, and do not paste the key into chat.

# Grok pictures. This is the same xAI key My Hub uses.
# Create one at https://console.x.ai/  — it starts with xai-
XAI_API_KEY=

# Optional. My Hub already uses this model. Leave the line off unless you were told to change it.
# The character card's own default name is grok-2-image. This editor follows My Hub.
# XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Optional. Where direct pictures are sent. Leave this off for xAI itself.
# A local relay is allowed only on this computer, for example http://127.0.0.1:8788/xai
# IMAGE_API_BASE_URL=https://api.x.ai

# Optional. The Hub bridge, if you already run My Hub on this computer.
# Start the Hub with: npm run dev
# Then pick "Hub bridge" in the editor. The default below is the Hub's usual address.
# HUB_BRIDGE_URL=http://127.0.0.1:8080
# BRIDGE_BASE_URL is another name for the same setting.
# BRIDGE_BASE_URL=http://127.0.0.1:8080

# Optional. Use another port if 8787 is already taken.
# IMAGE_EDITOR_PORT=8787

# Optional. Set to 1 to draw a practice picture on this computer, without calling xAI.
# IMAGE_EDITOR_MOCK=0
