# Browser-safe. Create an OAuth 2.0 Web client in Google Cloud Console
# (Authorized JavaScript origins: http://localhost:5173).
VITE_GOOGLE_CLIENT_ID=

# Server-only. Vite middleware uses these — they are never shipped to the browser.
# Create a Google Cloud API key with Google Drive API enabled. For folder-ID
# listing without OAuth, the Drive folder (or its files) must be shared as
# "Anyone with the link" can view.
GOOGLE_API_KEY=

# Optional Cartesia TTS (https://play.cartesia.ai/keys). If unset, the app
# falls back to Web Audio carriers + the browser speechSynthesis API.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
CARTESIA_MODEL_ID=sonic-3.6
CARTESIA_VERSION=2026-08-14
