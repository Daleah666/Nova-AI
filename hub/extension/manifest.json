{
  "manifest_version": 3,
  "name": "The Hub",
  "version": "1.6.1",
  "description": "Opens The Hub in every new tab and as a pop-up, opens your Hub apps as tabs and mini windows, voice and dictation for the Hub, Grok pictures with your key kept here, tidies forgotten tabs, and tracks your time (stored on this computer).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "idle",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:5600/*",
    "https://*.x.ai/*",
    "http://127.0.0.1:47800/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.elevenlabs.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "The Hub",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "commands": {
    "open-hub": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Pop up The Hub beside your browser"
    },
    "talk": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Talk to your Hub host (voice command)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}