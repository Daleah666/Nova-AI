# Copy this file to .env in the same folder. .env is not committed.
# Leave a line blank to skip that API. The Hub still opens.

# Claude, for chat with Nyx and for Familiar's brain when you run npm run dev.
# Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Blank uses claude-haiku-5-5 for short jobs and claude-sonnet-5-5 for normal chat.
# HUB_CLAUDE_MODEL_QUICK=claude-haiku-5-5
# HUB_CLAUDE_MODEL=claude-sonnet-5-5

# Grok pictures. You can leave this blank and paste the key in the Hub
# (robot icon, AI & keys). A pasted key is saved on this computer in ~/.the-hub/xai-key.
# XAI_API_KEY=

# Ports. You only need these if the defaults are taken.
# HUB_PORT=8080
# HUB_RELAY_PORT=47800
